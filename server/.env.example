# ==============================================================================
# TaskFlow Server Environment Configuration Blueprint
# Instructions: Copy this file to .env and customize values for your environment.
# Note: Never commit real production secrets or credentials to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB connection string (local MongoDB instance or MongoDB Atlas cluster)
MONGO_URI=mongodb://127.0.0.1:27017/taskflow
# Set to true to use an automated ephemeral in-memory MongoDB instance (zero-install demo/dev)
USE_IN_MEMORY_DB=false

# Authentication & Cryptographic Keys
# Provide cryptographically random secrets (at least 32 characters long in production)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_secret_at_least_32_characters_long
TOKEN_NAME=taskflow_token

# Cross-Origin Resource Sharing (CORS)
# Allowed frontend client origin
CORS_ORIGIN=http://localhost:5173

# Logging Configuration (error | warn | info | http | debug)
LOG_LEVEL=info
