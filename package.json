{
  "name": "taskflow-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-grade Task Management Application - TaskFlow",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "lint": "eslint client/src server/src",
    "typecheck": "npm run typecheck --workspace=server && npm run typecheck --workspace=client",
    "test:auth": "npm run test:auth --workspace=server",
    "test:tasks": "npm run test:tasks --workspace=server",
    "test:e2e": "npm run test:e2e --workspace=server",
    "test:qa:server": "npm run test:qa --workspace=server",
    "test:qa:client": "npm run test --workspace=client",
    "test": "npm run test:auth --workspace=server && npm run test:tasks --workspace=server && npm run test:e2e --workspace=server",
    "test:all": "npm test && npm run test:qa:server && npm run test:qa:client"
  },
  "devDependencies": {
    "@eslint/js": "9.21.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.72.1",
    "uri-js": "^4.4.1"
  }
}
